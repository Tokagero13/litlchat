{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gemini Tray",
  "version": "0.1.0",
  "identifier": "dev.tokagero.geminitray",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Gemini в трее",
    "longDescription": "Микро-браузер с чатом Gemini: панель по горячей клавише, ответ, свернул.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
